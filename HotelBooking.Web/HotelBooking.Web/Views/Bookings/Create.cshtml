@model HotelBooking.Web.Models.CreateBookingViewModel
@{
    ViewData["Title"] = "Create Booking";
}
<link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
<section class="page-heading">
    <a asp-controller="Home" asp-action="Index" class="eyebrow-link">← Trang chủ</a>
    <p class="eyebrow">ĐẶT PHÒNG</p>
    <h1>Tạo booking</h1>
    <p>Điền thông tin khách hàng và thời gian lưu trú để hoàn tất đặt phòng.</p>
</section>
<div class="form-card">
    <div class="room-id-chip">ROOM ID <strong>#@Model.RoomId</strong></div>
    <form asp-action="Create" method="post">
        <input asp-for="RoomId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid">
            <div class="field">
                <label asp-for="CustomerId"></label>
                <input asp-for="CustomerId" type="number" min="1" placeholder="Nhập Customer ID" />
                <span asp-validation-for="CustomerId"></span>
                <small>Nhập ID khách hàng đã có trong hệ thống.</small>
            </div>
            <div class="field">
                <label asp-for="GuestCount"></label>
                <input asp-for="GuestCount" type="number" min="1" max="20" />
                <span asp-validation-for="GuestCount"></span>
            </div>
            <div class="field">
                <label asp-for="CheckInDate"></label>
                <input asp-for="CheckInDate" type="date" />
                <span asp-validation-for="CheckInDate"></span>
            </div>
            <div class="field">
                <label asp-for="CheckOutDate"></label>
                <input asp-for="CheckOutDate" type="date" />
                <span asp-validation-for="CheckOutDate"></span>
            </div>
        </div>
        <div class="form-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-quiet">Hủy</a>
            <button class="btn btn-primary" type="submit">Xác nhận đặt phòng <span>→</span></button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
